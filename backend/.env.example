# put the structure of the env file here!
PORT=5000

# Supabase (Project Settings > API Keys in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Where the Next.js frontend runs (CORS + cookies). Next dev uses port 3000.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: Postgres connection string, only for running supabase/migrations with psql.
# Supabase dashboard > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
